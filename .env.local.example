# Copy to .env.local and fill from your Supabase project settings (API section).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used for cached writes to the public book metadata table and for
# applying Stripe webhook results. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Billing (Stripe)
# ---------------------------------------------------------------------------
# Absolute origin, used to build Checkout success/cancel URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret key: sk_test_... in development, sk_live_... in production. Server-only.
STRIPE_SECRET_KEY=sk_test_your-key

# Price IDs from the Stripe dashboard (Products → your product → Pricing).
#   MONTHLY  must be a recurring price   ($2 / month)
#   LIFETIME must be a one-time price    ($17 once)
STRIPE_PRICE_MONTHLY=price_your-monthly-price-id
STRIPE_PRICE_LIFETIME=price_your-lifetime-price-id

# Endpoint signing secret for POST /api/billing/webhook.
# Local: run `stripe listen --forward-to localhost:3000/api/billing/webhook`
# and copy the whsec_... it prints.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
